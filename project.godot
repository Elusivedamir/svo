config_version=5

[application]

config/name="Линия фронта: Командир батальона"
run/main_scene="res://scenes/loading.tscn"
config/icon="res://assets/icons/app_icon.png"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.04, 0.05, 0.05, 1)
boot_splash/minimum_display_time=0

[autoload]

MusicPlayer="*res://scripts/music_manager.gd"

[display]

window/size/viewport_width=2400
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.04, 0.05, 0.05, 1)
